{
  "description": "Circuit-Synth Library Development Environment",
  "version": "2.0.0",
  "model": "claude-sonnet-4-5",
  "subagentDefaults": {
    "model": "claude-haiku-4-5",
    "maxParallelAgents": 10,
    "strategy": "parallel-first"
  },
  "env": {
    "PYTHONPATH": "${PYTHONPATH}:./src",
    "CIRCUIT_SYNTH_DEV": "1"
  },
  "qualityGates": {
    "minTestCoverage": 80,
    "maxCyclomaticComplexity": 10,
    "maxFunctionLength": 30,
    "requireTypeHints": true,
    "requireDocstrings": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dangerous_command_blocker.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/universal_hook_logger.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_schematic_layout.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/universal_hook_logger.py\""
          }
        ]
      }
    ]
  }
}
